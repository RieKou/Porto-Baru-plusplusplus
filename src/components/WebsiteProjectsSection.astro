---
const websiteProjects = [
  {
    href: 'https://portfolio-vanessalee.netlify.app',
    src: 'https://portfolio-vanessalee.netlify.app',
    tag: 'React + Tailwind',
    title: 'Old Portfolio',
    description:
      'Personal portfolio showcasing artwork and frontend projects.',
  },

  {
    href: 'https://shu-profile.netlify.app/',
    src: 'https://shu-profile.netlify.app/',
    tag: 'ReactJS',
    title: 'Shu Profile',
    description:
      'First ReactJS project inspired by Arknights visual design.',
  },

  {
    href: 'https://karyautamasukses.netlify.app/',
    src: 'https://karyautamasukses.netlify.app/',
    tag: 'Vite + React + Tailwind',
    title: 'Karya Utama Sukses',
    description:
      'Experimental premium UI layout with layered hierarchy.',
  },
];
---

<section
  id="website-projects"
  class="section"
>
  <div class="section-title">
    <p class="eyebrow">
      Website Projects
    </p>

    <h2>
      Interactive UI Showcase
    </h2>
  </div>

  <div class="carousel-wrapper">
    <button
      class="carousel-btn prev"
      id="prevBtn"
    >
      ←
    </button>

    <div
      class="carousel-track"
      id="carouselTrack"
    >
      {websiteProjects.map(
        (project) => (
          <a
            href={project.href}
            target="_blank"
            class="website-card"
          >
            <!-- WEBSITE PREVIEW -->

            <div class="iframe-wrap">
              <iframe
                src={project.src}
                loading="lazy"
              ></iframe>
            </div>

            <!-- CONTENT -->

            <div class="website-content">
              <span class="tag">
                {project.tag}
              </span>

              <h3>
                {project.title}
              </h3>

              <p>
                {project.description}
              </p>
            </div>
          </a>
        )
      )}
    </div>

    <button
      class="carousel-btn next"
      id="nextBtn"
    >
      →
    </button>
  </div>
</section>

<style>
  /* SECTION */

  .section {
    max-width: 1300px;

    margin: 0 auto;

    padding: 7rem 2rem;
  }

  .section-title {
    margin-bottom: 3rem;
  }

  .eyebrow {
    color: #7c3aed;

    letter-spacing: 0.2em;

    text-transform: uppercase;
  }

  .section-title h2 {
    font-size: clamp(
      2.3rem,
      5vw,
      4rem
    );

    margin-top: 0.5rem;
  }

  /* CAROUSEL */

  .carousel-wrapper {
    position: relative;
  }

  .carousel-track {
    display: flex;

    gap: 1.5rem;

    overflow-x: auto;

    scroll-behavior: smooth;

    scrollbar-width: none;

    padding: 0.5rem;
  }

  .carousel-track::-webkit-scrollbar {
    display: none;
  }

  /* WEBSITE CARD */

  .website-card {
    min-width: 450px;

    border-radius: 32px;

    overflow: hidden;

    background:
      rgba(
        255,
        255,
        255,
        0.06
      );

    backdrop-filter: blur(18px);

    border: 1px solid
      rgba(
        255,
        255,
        255,
        0.08
      );

    transition: 0.35s ease;

    text-decoration: none;

    color: inherit;
  }

  .website-card:hover {
    transform:
      translateY(-8px)
      scale(1.01);

    border-color:
      rgba(
        124,
        58,
        237,
        0.35
      );

    box-shadow:
      0 20px 60px
      rgba(
        124,
        58,
        237,
        0.15
      );
  }

  /* IFRAME WRAP */

  .iframe-wrap {
    position: relative;

    width: 100%;

    height: 280px;

    overflow: hidden;

    background:
      linear-gradient(
        135deg,
        rgba(
          124,
          58,
          237,
          0.08
        ),
        rgba(
          6,
          182,
          212,
          0.08
        )
      );

    border-bottom: 1px solid
      rgba(
        255,
        255,
        255,
        0.08
      );
  }

  /* WEBSITE PREVIEW */

  .website-card iframe {
    width: 1440px;
    height: 900px;

    border: none;

    transform: scale(0.31);

    transform-origin: top left;

    pointer-events: none;

    overflow: hidden;

    scrollbar-width: none;

    filter:
      brightness(0.98)
      saturate(1.02);

    border-radius: 12px;
  }

  .website-card iframe::-webkit-scrollbar {
    display: none;
  }

  /* OVERLAY */

  .iframe-wrap::after {
    content: '';

    position: absolute;

    inset: 0;

    background:
      linear-gradient(
        to top,
        rgba(
          0,
          0,
          0,
          0.12
        ),
        transparent
      );

    pointer-events: none;
  }

  /* CONTENT */

  .website-content {
    padding: 1.8rem;
  }

  .website-content h3 {
    font-size: 1.6rem;

    margin-top: 1rem;
    margin-bottom: 0.8rem;
  }

  .website-content p {
    color: #94a3b8;

    line-height: 1.7;
  }

  .tag {
    display: inline-block;

    padding: 0.45rem 0.85rem;

    border-radius: 999px;

    background:
      linear-gradient(
        135deg,
        rgba(
          124,
          58,
          237,
          0.18
        ),
        rgba(
          6,
          182,
          212,
          0.18
        )
      );

    color: #8b5cf6;

    font-size: 0.8rem;

    font-weight: 600;
  }

  /* BUTTON */

  .carousel-btn {
    position: absolute;

    top: 50%;

    transform: translateY(-50%);

    width: 62px;
    height: 62px;

    border-radius: 999px;

    border: none;

    background: white;

    color: black;

    font-size: 1.2rem;

    cursor: pointer;

    z-index: 10;

    transition: 0.3s ease;
  }

  .carousel-btn:hover {
    transform:
      translateY(-50%)
      scale(1.08);
  }

  .prev {
    left: -20px;
  }

  .next {
    right: -20px;
  }

  /* MOBILE */

  @media (max-width: 960px) {
    .website-card {
      min-width: 100%;
    }

    .carousel-btn {
      display: none;
    }

    .iframe-wrap {
      height: 220px;
    }

    .website-card iframe {
      transform: scale(0.24);
    }
  }
</style>

<script>
  const track =
    document.getElementById(
      'carouselTrack'
    );

  document
    .getElementById('nextBtn')
    ?.addEventListener(
      'click',
      () => {
        track?.scrollBy({
          left: 480,
          behavior: 'smooth',
        });
      }
    );

  document
    .getElementById('prevBtn')
    ?.addEventListener(
      'click',
      () => {
        track?.scrollBy({
          left: -480,
          behavior: 'smooth',
        });
      }
    );
</script>