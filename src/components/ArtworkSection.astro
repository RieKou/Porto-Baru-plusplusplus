---
import Comms1 from '../assets/Comms1.png';
import Comms2 from '../assets/Comms2.png';
import Kamui from '../assets/Kamui.png';
---

<section id="projects" class="section">
  <div class="section-title">
    <p class="eyebrow">Featured Artwork</p>
    <h2>Recent commissions</h2>
  </div>

  <div class="project-cards">
    <div class="project-card">
      <img src={Comms1.src} class="project-image" />
      <div class="project-overlay">First Commission</div>
    </div>

    <div class="project-card">
      <img src={Comms2.src} class="project-image" />
      <div class="project-overlay">Second Commission</div>
    </div>

    <div class="project-card">
      <img src={Kamui.src} class="project-image" />
      <div class="project-overlay">Kamui Fanart</div>
    </div>
  </div>
</section>
<style>
  .section {
    max-width: 1300px;
    margin: 0 auto;
    padding: 7rem 2rem;
  }
  .section-title {
    margin-bottom: 3rem;
  }
  .eyebrow {
    color: #7c3aed;
    text-transform: uppercase;
    letter-spacing: 0.2em;
  }
  .project-cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .project-card {
    position: relative;
    overflow: hidden;
    border-radius: 32px;
  }
  .project-image {
    width: 100%;
    height: 420px;
    object-fit: cover;
    transition: transform 0.4s ease;
    display: block;
  }
  .project-card:hover .project-image {
    transform: scale(1.08);
  }
  .project-overlay {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: flex-end;
    padding: 2rem;
    background: linear-gradient(to top, rgba(0, 0, 0, 0.8), transparent);
    color: white;
    font-size: 1.3rem;
    font-weight: 700;
  }
  @media (max-width: 960px) {
    .project-cards {
      grid-template-columns: 1fr;
    }
    .section {
      padding: 4rem 1rem;
    }
  }
</style>

    <!-- SCRIPT -->

    <script>

      // CURSOR

      const cursor =
        document.querySelector(
          '.cursor'
        ) as HTMLElement | null;

      const blur =
        document.querySelector(
          '.cursor-blur'
        ) as HTMLElement | null;

      window.addEventListener(
        'mousemove',
        (e) => {
          if (cursor && blur) {
            cursor.style.left =
              e.clientX + 'px';

            cursor.style.top =
              e.clientY + 'px';

            blur.style.left =
              e.clientX + 'px';

            blur.style.top =
              e.clientY + 'px';
          }
        }
      );

      // CAROUSEL

      const track =
        document.getElementById(
          'carouselTrack'
        );

      document
        .getElementById('nextBtn')
        ?.addEventListener(
          'click',
          () => {
            if (track) {
              track.scrollBy({
                left: 480,
                behavior: 'smooth',
              });
            }
          }
        );

      document
        .getElementById('prevBtn')
        ?.addEventListener(
          'click',
          () => {
            if (track) {
              track.scrollBy({
                left: -480,
                behavior: 'smooth',
              });
            }
          }
        );
    </script>
  </body>

